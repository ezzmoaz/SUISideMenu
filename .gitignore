/Package.resolved
.swiftpm/configuration
.swiftpm/**/xcuserdata/

# Xcode
/*.xcodeproj
xcuserdata/
*.xcuserstate
DerivedData/

# Source recordings for the README GIFs (the .gif outputs are committed)
*.mov
